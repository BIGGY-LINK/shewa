{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/api(?:/.*)?",
      "status": 404
    },
    {
      "src": "/includes(?:/.*)?",
      "status": 404
    },
    {
      "src": "/(.*\\.php)$",
      "dest": "/api/index.php?route=$1"
    },
    {
      "src": "/",
      "dest": "/api/index.php?route=/"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php?route=$1"
    }
  ]
}
